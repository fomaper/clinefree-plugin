# Copy to .env (which is gitignored) and fill in. deploy.sh sources it.

NAS_HOST=192.0.2.10
NAS_PASS=changeme

# CPA's config directory on that host, e.g. /path/to/cli-proxy-api
CPA_DIR=changeme

# Optional: enables the automatic reload + verification step.
# CPA_MGMT_KEY=changeme

# Optional overrides
# SSH_PORT=22
# SSH_USER=root
# CPA_PORT=8317
# DOCKER=docker
